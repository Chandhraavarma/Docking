#GRID_PARAMETER_FILE C:/Users/mchan/OneDrive/Desktop/docking/1.gpf
#
ndim=3			# number of dimensions in the field
dim1=127			# number of x-elements
dim2=127			# number of y-elements
dim3=127			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=8		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=3DTC.maps.xyz filetype=ascii offset=0
coord 2 file=3DTC.maps.xyz filetype=ascii offset=2
coord 3 file=3DTC.maps.xyz filetype=ascii offset=4
label=A-affinity	# component label for variable 1
label=C-affinity	# component label for variable 2
label=NA-affinity	# component label for variable 3
label=OA-affinity	# component label for variable 4
label=N-affinity	# component label for variable 5
label=HD-affinity	# component label for variable 6
label=Electrostatics	# component label for variable 6
label=Desolvation	# component label for variable 7
#
# location of affinity grid files and how to read them
#
variable 1 file=3DTC.A.map filetype=ascii skip=6
variable 2 file=3DTC.C.map filetype=ascii skip=6
variable 3 file=3DTC.NA.map filetype=ascii skip=6
variable 4 file=3DTC.OA.map filetype=ascii skip=6
variable 5 file=3DTC.N.map filetype=ascii skip=6
variable 6 file=3DTC.HD.map filetype=ascii skip=6
variable 7 file=3DTC.e.map filetype=ascii skip=6
variable 8 file=3DTC.d.map filetype=ascii skip=6
